<CalcButton@Button>:
    background_normal: ''
    font_size: "35sp"
    color: 1, 1, 1, 1
    # Borde redondeado improvisado o color plano elegante
    background_color: 0.3, 0.3, 0.3, 1

<NumButton@CalcButton>:
    background_color: 0.25, 0.25, 0.25, 1

<OpButton@CalcButton>:
    background_color: 1, 0.6, 0, 1  # Naranja
    font_size: "45sp"

<EqualButton@CalcButton>:
    background_color: 0.2, 0.8, 0.4, 1  # Verde
    font_size: "45sp"

<ClearButton@CalcButton>:
    background_color: 0.9, 0.3, 0.3, 1  # Rojo
    font_size: "35sp"

<Calculadora>:
    orientation: 'vertical'
    padding: 15

    # Fondo principal (superficie exterior)
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        spacing: 15
        padding: 15
        
        # Fondo del área de la calculadora
        canvas.before:
            Color:
                rgba: 0.15, 0.15, 0.15, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [15]

        BoxLayout:
            orientation: 'horizontal'
            spacing: 10
            size_hint_y: 0.2

            Label:
                id: display
                text: "0"
                font_size: "50sp"
                color: 1, 1, 1, 1
                halign: "right"
                valign: "middle"
                size_hint_x: 0.75
                text_size: self.width - 20, self.height
                canvas.before:
                    Color:
                        rgba: 0.2, 0.2, 0.2, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]

            ClearButton:
                text: "C"
                size_hint_x: 0.25
                on_release: root.on_clear()

        GridLayout:
            cols: 4
            rows: 5
            spacing: 10
            size_hint_y: 0.8

            NumButton:
                text: "7"
                on_release: root.on_button_press(self)
            NumButton:
                text: "8"
                on_release: root.on_button_press(self)
            NumButton:
                text: "9"
                on_release: root.on_button_press(self)
            OpButton:
                text: "*"
                on_release: root.on_button_press(self)
            NumButton:
                text: "4"
                on_release: root.on_button_press(self)
            NumButton:
                text: "5"
                on_release: root.on_button_press(self)
            NumButton:
                text: "6"
                on_release: root.on_button_press(self)
            OpButton:
                text: "/"
                on_release: root.on_button_press(self)
            NumButton:
                text: "1"
                on_release: root.on_button_press(self)
            NumButton:
                text: "2"
                on_release: root.on_button_press(self)
            NumButton:
                text: "3"
                on_release: root.on_button_press(self)
            OpButton:
                text: "-"
                on_release: root.on_button_press(self)
            NumButton:
                text: "0"
                on_release: root.on_button_press(self)
            NumButton:
                text: "."
                on_release: root.on_button_press(self)
            EqualButton:
                text: "="
                on_release: root.on_button_press(self)
            OpButton:
                text: "+"
                on_release: root.on_button_press(self)
